package main

import (
	"fmt"
	"math"
	"tpm_sync/tpm_controllers"

	"github.com/sourcegraph/conc/pool"
)

const maxLastLayerNeurons = 5
const defaultNeuronDifference = 1
const firstLayerStimStep = 16 //The first will not be increased by one, but by firstLayerStimStep
const maxGoroutines = 4

//Non overlapped TPMs are created using an array that specifies how many stimulus each neuron in each layer has.
// For example: [2,3,4] means that the first layer has two stimulus each neuron, the second layer has three stimulus per neuron and the third layer has four stimullus per neuron

func runCheck_noOverlap(expectedSize int) []tpm_controllers.TPMmSettings {
	syncController := tpm_controllers.SyncController{}
	workerPool := pool.NewWithResults[[]tpm_controllers.TPMmSettings]().
		WithMaxGoroutines(maxGoroutines)

	for i := 1; i <= maxLayerCount; i++ {
		layerCount := i // capture loop variable safely
		workerPool.Go(func() []tpm_controllers.TPMmSettings {
			var localConfigList []tpm_controllers.TPMmSettings
			N := createMinimalStimArray(layerCount)

			for N[0] <= maxStimCount {
				//For a set amount of layers, try all k_last values within the boundaries
				for k_last := minNeuronsPerLayer; k_last <= maxLastLayerNeurons; k_last++ {
					if k_last*N[layerCount-1]*8 > expectedSize {
						break
					}
					config, err := syncController.SettingsFactory(N, k_last, default_L, default_M, "no_overlap", "Hebbian")
					if err != nil {
						fmt.Print(err)
						continue
					}
					size := syncController.GetDataSizeFromConfig(config)
					if size*8 > expectedSize {
						break
					}

					if CheckPowerOfTwo(size*8) == 0 && size*8 == expectedSize {
						configCopy := config
						localConfigList = append(localConfigList, configCopy)
					}
				}
				N = checkNextLayer_NoOverlap(N)
			}
			return localConfigList
		})
	}

	// Wait for all goroutines and gather results
	results := workerPool.Wait() // returns [][]TPMmSettings

	// Merge all into one slice
	var all []tpm_controllers.TPMmSettings
	for _, batch := range results {
		all = append(all, batch...)
	}
	return all
}

func checkNextLayer_NoOverlap(n_old []int) (n []int) {
	h := len(n_old)
	n = n_old
	for i := 0; i < h; i++ {
		lastLayerIndex := h - 1 - i
		//If the previous layer is not maxed, or if the previous layer is the last layer
		if n_old[lastLayerIndex] != maxStimCount || lastLayerIndex == 0 {
			if lastLayerIndex == 0 {
				n[lastLayerIndex] += firstLayerStimStep
			} else {
				n[lastLayerIndex]++
			}
			return n
		}
		//If the prev layer is maxed, we loop until we find a maxed layer
		n[lastLayerIndex] = minStimCount
	}

	return n

}

func createMinimalStimArray(layerCount int) []int {
	output := make([]int, layerCount)
	for i := 0; i < len(output); i++ {
		output[i] = minStimCount
	}

	return output
}

func getMaxN_H(k_h, H, expectedSize int) float64 {
	//This func gets a theoretical max, it allows us to set a max range for the test

	//The last layer needs to be maxed out, the other layers are to be tested.
	testDivisor := 0
	for i := 0; i < H; i++ {
		testDivisor += int(math.Pow(2, float64(i)))
	}
	testDivisor *= k_h
	n_H := float64(expectedSize) / float64(testDivisor)
	return n_H
}


	return all
}

func getMinSize(layerK, layerN, H int) int {
	totalWeights := 0
	for i := 0; i < H; i++ {
		layerWeightCount := layerK * layerN //We can have at least two inputs per neuron
		totalWeights += layerWeightCount

		//Set for next iteration
		layerK = layerWeightCount //In no overlap, each input is the output of another neuron
		layerN = 2                //After the first layer, just try with two for now
	}
	return totalWeights
}

func calculateSizeNoOverlap(N []int, k_h, H int) int {
	sum := 0
	for i := 0; i < H-1; i++ {
		mul := 1
		for j := i; j < H-1; j++ {
			mul *= N[j]
		}
		sum += mul
	}
	return (k_h * N[H-1]) * (1 + sum)
}

func getNCombinations(k_h, H, expectedSize int) [][]int {
	var result [][]int
	lastLayerIndex := H - 1
	if expectedSize%k_h != 0 {
		// fmt.Println("k_h needs to be a divisor of expectedSize")
		return nil
	}

	//Setup the minimal stim array
	N := createMinimalStimArray(H)
	for true { //The last layer has to be a divisor of expectedSize
		if expectedSize%N[lastLayerIndex] != 0 {
			N[lastLayerIndex] += 1
			continue
		} else {
			break
		}
	}

	//Setup done, time to test
	highestLayerIndex := 0
	// maxedLayerIndex := -1
	for true {
		calculatedSize := calculateSizeNoOverlap(N, k_h, H)
		if calculatedSize == expectedSize {
			copyN := make([]int, H)
			copy(copyN, N)

			result = append(result, copyN)
		}
		if calculatedSize > expectedSize {
			isHighestLayerMaxed := true
			for i := 0; i < highestLayerIndex; i++ {
				if N[i] != minStimCount { //We have maxed out the network size, but we can still add another stim to the next layer
					isHighestLayerMaxed = false
					N[i+1]++                  //If the layer is not maxed, add one stim. (Layers are maxed when all layers before are minStimCount)
					for j := 0; j <= i; j++ { //reset all layers up to the highestLayerIndex
						N[i] = minStimCount
					}
					break
				}
			}
			if isHighestLayerMaxed {
				highestLayerIndex++
				if highestLayerIndex >= H {
					break
				}
				// maxedLayerIndex++
				N[highestLayerIndex]++
				for i := 0; i < highestLayerIndex; i++ {
					N[i] = minStimCount
				}
			}
			continue //If we max the size limit, then we should not keep adding before testing the new N config
			//  (or else the first layer is never maxed out)
		}
		N[0]++
	}

	return result

}


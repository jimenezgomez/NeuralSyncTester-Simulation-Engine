func getMinNetConfig(minSize, k_H, H int) {
	lastSize := 0
	n_H := minStimCount - 1 // we subtract by 1 to accomodate for the while loop
	for lastSize < minSize {
		n_H++
		lastSize = getMinSize(k_H, n_H, H)
	}
	fmt.Printf("Min config found: K_H %d | N_H %d | H %d | size: %d", k_H, n_H, H, lastSize)
}

func main() {
	networkSizes := []int{512, 768, 1024, 2048}
	k_h_list := []int{2, 3, 4}

	H_list := []int{1}
	syncController := tpm_controllers.SyncController{}
	for _, expectedSize := range networkSizes {
		quantizedSize := expectedSize / 8 //convert from bits to bytes
		for _, k_h := range k_h_list {
			var output_combinations [][]int
			for _, H := range H_list {
				combinations := getNCombinations(k_h, H, quantizedSize)
				output_combinations = append(output_combinations, combinations...)
			}
			if len(output_combinations) != 0 {
				var output_configs_noOverlap []tpm_controllers.TPMmSettings
				var output_configs_partialOverlap = make(map[int][]tpm_controllers.TPMmSettings)
				var output_configs_fullOverlap = make(map[int][]tpm_controllers.TPMmSettings)
				for _, N := range output_combinations {
					configNoOverlap, err := syncController.SettingsFactory(N, k_h, default_L, default_M, "no_overlap", "Hebbian")
					if err != nil {
						fmt.Print(err)
						continue
					}
					//Translate to overlapped configs
					K := configNoOverlap.K
					n_0 := configNoOverlap.N[0]
					configPartialOverlap, err := syncController.SettingsFactory(K, n_0, default_L, default_M, "partial_overlap", "Hebbian")
					if err != nil {
						fmt.Print(err)
						continue
					}
					configFullOverlap, err := syncController.SettingsFactory(K, n_0, default_L, default_M, "full_overlap", "Hebbian")
					if err != nil {
						fmt.Print(err)
						continue
					}

					output_configs_noOverlap = append(output_configs_noOverlap, configNoOverlap)
					output_configs_partialOverlap[n_0] = append(output_configs_partialOverlap[n_0], configPartialOverlap)
					output_configs_fullOverlap[n_0] = append(output_configs_fullOverlap[n_0], configFullOverlap)
				}
				fileName := fmt.Sprintf("./newSizes/%d/noOverlap_%d.json", expectedSize, k_h)
				err := exportSettingsToFileNoOverlap(output_configs_noOverlap, k_h, fileName)
				if err != nil {
					fmt.Println(err)
				}
				for n_0, v := range output_configs_partialOverlap {
					fileName = fmt.Sprintf("./newSizes/%d/partialOverlap_%d.json", expectedSize, n_0)
					err = exportSettingsToFileOverlap(v, n_0, fileName, "partial_overlap")
					if err != nil {
						fmt.Println(err)
					}
				}
				for n_0, v := range output_configs_fullOverlap {
					fileName = fmt.Sprintf("./newSizes/%d/fullOverlap_%d.json", expectedSize, n_0)
					err = exportSettingsToFileOverlap(v, n_0, fileName, "full_overlap")
					if err != nil {
						fmt.Println(err)
					}
				}
			}
		}
	}


func CheckPowerOfTwo(n int) int {
	//added one corner case if n is zero it will also consider as power 2
	if n == 0 {
		return 1
	}
	return n & (n - 1)
}

type TPMConfigFileNoOverlap struct {
	TPMType         string   `json:"scenario"`
	MaxSessionCount int      `json:"max_session_count"`
	MaxIterations   int      `json:"max_iterations"`
	MaxWorkerCount  int      `json:"max_worker_count"`
	MConfigs        []int    `json:"m_configs"`
	LConfigs        []int    `json:"l_configs"`
	LearnRules      []string `json:"learn_rules"`
	NConfigs        [][]int  `json:"n_configs"`
	KLastConfigs    []int    `json:"klast_configs"`
}

func exportSettingsToFileNoOverlap(configList []tpm_controllers.TPMmSettings, k_last int, filename string) error {
	// Open or create the file
	file, err := os.Create(filename)
	if err != nil {
		return err
	}
	defer file.Close()

	var NConfigs [][]int
	for _, v := range configList {
		NConfigs = append(NConfigs, v.N)
	}

	configFileData := TPMConfigFileNoOverlap{
		TPMType:         "no_overlap",
		MaxSessionCount: 20,
		MaxIterations:   100000,
		MaxWorkerCount:  12,
		MConfigs:        []int{1},
		LConfigs:        []int{3},
		LearnRules:      []string{"Hebbian"},
		NConfigs:        NConfigs,
		KLastConfigs:    []int{k_last},
	}

	// Marshal the slice to JSON
	jsonData, err := json.MarshalIndent(configFileData, "", "  ") // Pretty-printed JSON
	if err != nil {
		return err
	}

	// Write the JSON data to the file
	_, err = file.Write(jsonData)
	if err != nil {
		return err
	}

	return nil
}

type TPMConfigFileOverlap struct {
	TPMType         string   `json:"scenario"`
	MaxSessionCount int      `json:"max_session_count"`
	MaxIterations   int      `json:"max_iterations"`
	MaxWorkerCount  int      `json:"max_worker_count"`
	MConfigs        []int    `json:"m_configs"`
	LConfigs        []int    `json:"l_configs"`
	LearnRules      []string `json:"learn_rules"`
	N0Configs       []int    `json:"n0_configs"`
	KConfigs        [][]int  `json:"k_configs"`
}

func exportSettingsToFileOverlap(configList []tpm_controllers.TPMmSettings, n_0 int, filename, scenario string) error {
	// Open or create the file
	file, err := os.Create(filename)
	if err != nil {
		return err
	}
	defer file.Close()

	var KConfigs [][]int
	for _, v := range configList {
		KConfigs = append(KConfigs, v.K)
	}

	configFileData := TPMConfigFileOverlap{
		TPMType:         scenario,
		MaxSessionCount: 10,
		MaxIterations:   100000,
		MaxWorkerCount:  12,
		MConfigs:        []int{1},
		LConfigs:        []int{3},
		LearnRules:      []string{"Hebbian"},
		KConfigs:        KConfigs,
		N0Configs:       []int{n_0},
	}

	// Marshal the slice to JSON
	jsonData, err := json.MarshalIndent(configFileData, "", "  ") // Pretty-printed JSON
	if err != nil {
		return err
	}

	// Write the JSON data to the file
	_, err = file.Write(jsonData)
	if err != nil {
		return err
	}

	return nil
}
